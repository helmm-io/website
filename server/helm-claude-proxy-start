#!/bin/bash
# Fetches the Anthropic API key from SSM Parameter Store (SecureString) and
# starts the proxy with it in the environment. Runs as the systemd service
# helm-claude-proxy; the instance role only has read access to this parameter.
set -euo pipefail
export ANTHROPIC_API_KEY="$(aws ssm get-parameter \
  --name /helm/anthropic/api_key --with-decryption \
  --region eu-west-2 --query Parameter.Value --output text)"
exec /usr/bin/python3 /opt/helm-website/server/claude_proxy.py
