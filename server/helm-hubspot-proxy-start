#!/bin/bash
# Fetches the HubSpot private-app token from SSM Parameter Store (SecureString)
# and starts the proxy with it in the environment. Runs as the systemd service
# helm-hubspot-proxy; the instance role only has read access to this parameter.
#
# If the fetch fails we log why and still start the proxy, which then answers
# 503 so the site degrades gracefully instead of crash-looping.
set -uo pipefail
PARAM=/helm/hubspot/pat

if HUBSPOT_PAT="$(aws ssm get-parameter \
    --name "$PARAM" --with-decryption \
    --region eu-west-2 --query Parameter.Value --output text)"; then
  export HUBSPOT_PAT
else
  echo "warning: could not read $PARAM from SSM (aws error above)" >&2
  echo "warning: check the parameter exists and the instance role may ssm:GetParameter it; starting without a token (proxy answers 503)" >&2
  export HUBSPOT_PAT=""
fi

exec /usr/bin/python3 /opt/helm-website/server/hubspot_proxy.py
